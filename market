import aiohttp
import pandas as pd
import logging

logger = logging.getLogger("Doshka")


BINANCE_SPOT = "https://api.binance.com/api/v3/klines"

BINANCE_FUTURES = "https://fapi.binance.com/fapi/v1/klines"



async def get_market_data(
    symbol,
    timeframe="1h",
    market="spot"
):

    symbol = symbol.upper() + "USDT"


    url = (
        BINANCE_FUTURES
        if market == "future"
        else BINANCE_SPOT
    )


    params = {
        "symbol": symbol,
        "interval": timeframe,
        "limit": 300
    }


    try:

        async with aiohttp.ClientSession() as session:

            async with session.get(
                url,
                params=params,
                timeout=20
            ) as response:


                if response.status != 200:

                    raise Exception(
                        f"Binance Error {response.status}"
                    )


                data = await response.json()



        candles=[]


        for c in data:

            candles.append({

                "time":
                    pd.to_datetime(
                        c[0],
                        unit="ms"
                    ),

                "open":
                    float(c[1]),

                "high":
                    float(c[2]),

                "low":
                    float(c[3]),

                "close":
                    float(c[4]),

                "volume":
                    float(c[5])

            })


        return pd.DataFrame(candles)



    except Exception as e:

        logger.error(
            f"Market data error: {e}"
        )

        return pd.DataFrame()
